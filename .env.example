# ===== Application =====
APP_NAME=FastAPI API
ENVIRONMENT=development

# ===== Database =====
# SQLite local (default sem Docker):
DATABASE_URL=sqlite:///./app.db
#
# PostgreSQL (default ao rodar com Docker compose):
# DATABASE_URL=postgresql+psycopg://cowork:cowork@localhost:5432/cowork

# ===== JWT =====
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
