# ===== Application =====
APP_NAME=FastAPI API
ENVIRONMENT=development

# ===== Database =====
# SQLite local (default sem Docker):
DATABASE_URL=sqlite:///./app.db
#
# PostgreSQL (default ao rodar com Docker compose):
# DATABASE_URL=postgresql+psycopg://cowork:cowork@localhost:5432/cowork

# ===== JWT =====
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== CORS =====
# Origens permitidas, separadas por virgula. NAO use "*" em producao.
# Default em config.py cobre dev local (Vite 5173 e React 3000).
# Em staging/producao no Render, sobrescreva no painel de Environment:
#   CORS_ORIGINS=https://app-staging.exemplo.com,http://localhost:5173
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
